# Constructor (admin-cabinet) bot token.
CONSTRUCTOR_BOT_TOKEN=123456:AAAAA-BBBBB_CCCCC

# Optional seed managed bots (legacy mode).
# You can leave BOT_TOKENS empty and add bots later via constructor UI.
BOT_TOKENS=

# If set, used for seed bots unless overridden by BOT_ADMIN_CHAT_IDS.
ADMIN_CHAT_ID=-1001234567890
# Optional per-bot admin chats, aligned with BOT_TOKENS order.
# BOT_ADMIN_CHAT_IDS=-1001234567890,-1009876543210
# Optional Telegram user IDs allowed to run /service_broadcast in constructor bot.
# SERVICE_OWNER_TELEGRAM_IDS=5071722833

DATABASE_URL=sqlite+aiosqlite:///./data/feedback_bot.db
REDIS_URL=redis://redis:6379/0
MANAGED_BOTS_SYNC_INTERVAL_SECONDS=8
LOG_LEVEL=INFO
